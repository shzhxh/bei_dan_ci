{
  "id": "p15",
  "title": "The Art Market by the River",
  "titleZh": "河边的艺术市集",
  "topic": "市集",
  "paragraphs": [
    [
      {
        "en": "A bright art market opens early beside the quiet river.",
        "zh": "一个明亮的艺术市集一早在安静的河边开张。"
      },
      {
        "en": "She comes with her cousin very early on a cool morning.",
        "zh": "她在一个凉爽的早晨很早就和她的表亲一起来了。"
      },
      {
        "en": "One long wooden board holds a picture of the old bridge.",
        "zh": "一块长木板上面挂着一幅老桥的画。"
      },
      {
        "en": "Any fresh vegetable here is cheap and very good for us.",
        "zh": "这里任何新鲜的蔬菜都便宜，对我们很有好处。"
      },
      {
        "en": "We must arrive early because the best space goes fast.",
        "zh": "我们必须早点到，因为最好的位置很快就没了。"
      },
      {
        "en": "Then her pictures show a different side of our old town.",
        "zh": "然后她的画展现了我们老镇的另一面。"
      },
      {
        "en": "Both happy children help us fix the old wooden table.",
        "zh": "两个快乐的孩子帮我们修那张旧木桌。"
      },
      {
        "en": "A little sign explains each term in plain, simple words.",
        "zh": "一块小牌子用朴素简单的词解释每一个术语。"
      },
      {
        "en": "We are sure the tall shelf is easy to reach.",
        "zh": "我们确信那个高架子很容易够到。"
      },
      {
        "en": "They raise a bright flag across the narrow, busy street.",
        "zh": "他们把一面鲜艳的旗子举过狭窄繁忙的街道。"
      }
    ],
    [
      {
        "en": "We love the deep blue paint on the back wall.",
        "zh": "我们喜欢后墙那层深蓝色的漆。"
      },
      {
        "en": "My brother brings a small radio and a loud drum.",
        "zh": "我哥哥带来一台小收音机和一面响亮的鼓。"
      },
      {
        "en": "Then eighty people visit our stall during the first happy period.",
        "zh": "然后八十个人在第一个愉快的时段来看我们的摊位。"
      },
      {
        "en": "Someone with real knowledge explains every small detail to us.",
        "zh": "一位真正有知识的人给我们讲解每一个小细节。"
      },
      {
        "en": "Her new skill moves our small stall forward this year.",
        "zh": "她的新技能今年把我们的小摊位往前推了一步。"
      },
      {
        "en": "Later we listen and discover a sweet new song from them.",
        "zh": "后来我们听着，从他们那里发现了一首甜美的新歌。"
      },
      {
        "en": "My grandfather's old wooden chair is worth real money now.",
        "zh": "我祖父那把旧木椅现在值不少钱。"
      },
      {
        "en": "A quick review finds a missing pair of warm gloves.",
        "zh": "一次快速核对发现少了一双暖和的手套。"
      },
      {
        "en": "My aunt sits alone and answers the ringing telephone again.",
        "zh": "我姑姑独自坐着，又一次接起响个不停的电话。"
      },
      {
        "en": "Dinner brings hot soup, fresh bread, and a boiled egg.",
        "zh": "晚餐端来热汤、新鲜面包和一个煮鸡蛋。"
      }
    ],
    [
      {
        "en": "A dry road makes the bike ride safe and short.",
        "zh": "干燥的路让自行车骑起来又安全又短。"
      },
      {
        "en": "The fifth teacher will dismiss the noisy class at noon.",
        "zh": "第五位老师会在中午让吵闹的班级下课。"
      },
      {
        "en": "A short text starts a long, warm conversation about music.",
        "zh": "一条短短的信息开启了关于音乐的长而温暖的对话。"
      },
      {
        "en": "They buy cold drinks near the lake, and the noise grows.",
        "zh": "他们在湖边买冷饮，噪音越来越大。"
      },
      {
        "en": "Sweet yellow sugar sits in a small glass bowl on the shelf.",
        "zh": "甜甜的黄糖放在架子上一个小玻璃碗里。"
      },
      {
        "en": "The proud girl holds a big red apple high above us.",
        "zh": "那个骄傲的女孩高高举起一个大红苹果。"
      },
      {
        "en": "A long pen and a soft brush lie together in the bag.",
        "zh": "一支长钢笔和一把软刷子一起放在袋子里。"
      },
      {
        "en": "A parliamentary commentator writes about our small town each week.",
        "zh": "一位国会评论员每周写一篇关于我们小镇的文章。"
      }
    ]
  ],
