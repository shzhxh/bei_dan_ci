{
  "id": "b04",
  "title": "A Night at the Zoo Camp",
  "titleZh": "动物园夜营的一晚",
  "topic": "出行",
  "paragraphs": [
    [
      {
        "en": "We get up before the sun and pack our heavy schoolbag.",
        "zh": "我们在太阳出来前起床，收拾好沉重的书包。"
      },
      {
        "en": "I pack warm jeans and a heavy, long winter overcoat.",
        "zh": "我装进暖和的牛仔裤和一件厚重的大衣。"
      },
      {
        "en": "My passport and a small present fill the front coat pocket.",
        "zh": "我的护照和一份小礼物塞满了前面的外套口袋。"
      },
      {
        "en": "The sky is cloudy, so we hurry to the front gate.",
        "zh": "天空阴沉，所以我们赶紧走向大门。"
      },
      {
        "en": "Our teacher leads us to a short, friendly, warm introduction.",
        "zh": "老师带我们做了一个简短、友好又温暖的介绍。"
      },
      {
        "en": "Our everyday count is twenty, but today we are more.",
        "zh": "我们平时点数是二十人，但今天人数更多。"
      }
    ],
    [
      {
        "en": "The city zoo has tall bamboo near the front gate.",
        "zh": "城市动物园的前门附近长着高高的竹子。"
      },
      {
        "en": "A sleepy panda chews fresh green leaves behind the glass.",
        "zh": "一只困倦的熊猫在玻璃后面嚼着新鲜的绿叶。"
      },
      {
        "en": "A zebra and a giraffe share one long wooden fence.",
        "zh": "一匹斑马和一只长颈鹿共用一道长长的木栅栏。"
      },
      {
        "en": "An elephant eats, and a small brown monkey makes faces.",
        "zh": "一头大象在吃东西，一只棕色的小猴子在做鬼脸。"
      },
      {
        "en": "A small mouse stays awake near our old stone wall.",
        "zh": "一只小老鼠在我们旁边的旧石墙边醒着。"
      },
      {
        "en": "Our green tent sits on a bank above the lake.",
        "zh": "我们的绿色帐篷搭在湖上面的岸坡上。"
      }
    ],
    [
      {
        "en": "Warm soup and a green salad wait at the table.",
        "zh": "热汤和一份绿色沙拉在桌上等着我们。"
      },
      {
        "en": "A hot hamburger and one red strawberry fill my plate.",
        "zh": "一个热汉堡和一颗红草莓装满了我的盘子。"
      },
      {
        "en": "A silver fork rests beside a ripe yellow banana.",
        "zh": "一把银色叉子放在一根熟黄香蕉旁边。"
      },
      {
        "en": "The old cooker smells, so we take out the rubbish.",
        "zh": "旧炉子有味道，所以我们把垃圾拿出去。"
      },
      {
        "en": "A small doll and a toy robot watch us eat.",
        "zh": "一个小娃娃和一个玩具机器人看着我们吃饭。"
      },
      {
        "en": "A basket of fruit waits beside the chess board.",
        "zh": "一篮水果放在棋盘旁边。"
      }
    ],
    [
      {
        "en": "The old piano sounds boring after our long walk.",
        "zh": "走了那么久之后，那架旧钢琴听起来很无聊。"
      },
      {
        "en": "After lunch, we practise volleyball until the sky grows dark.",
        "zh": "午饭后，我们练排球一直练到天色变暗。"
      },
      {
        "en": "A big dictionary helps me pronounce each new word.",
        "zh": "一本大词典帮我读出每一个新单词的发音。"
      },
      {
        "en": "Her soft, clear accent makes the poem fun to recite.",
        "zh": "她柔和清晰的口音让这首诗念起来很有趣。"
      },
      {
        "en": "A long western film ends before our math class today.",
        "zh": "一部很长的西部片今天在我们的数学课前结束了。"
      },
      {
        "en": "My homework is lost under a bottle of ink.",
        "zh": "我的作业丢在一瓶墨水下面。"
      }
    ],
    [
      {
        "en": "By early morning, a high fever and the flu arrive.",
        "zh": "一大早，高烧和流感就来了。"
      },
      {
        "en": "The cold night wind feels cruel and mean outside now.",
        "zh": "夜里外面的冷风让人觉得又残酷又刻薄。"
      },
      {
        "en": "My grandfather sends a long postcard from the blue Pacific.",
        "zh": "我的祖父从蓝色的太平洋寄来一张长长的明信片。"
      },
      {
        "en": "A red skirt in the gift shop excites my sister.",
        "zh": "礼品店里一条红裙子让妹妹兴奋不已。"
      },
      {
        "en": "We pick up litter before we leave the zoo.",
        "zh": "离开动物园前，我们把垃圾捡起来。"
      }
    ]
  ],
