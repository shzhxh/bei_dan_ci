{
  "id": "b05",
  "title": "The Kite and the Toothache",
  "titleZh": "风筝与牙痛",
  "topic": "日常与健康",
  "paragraphs": [
    [
      {
        "en": "The sunny morning turns cold and windy before our breakfast.",
        "zh": "晴朗的早晨在我们吃早饭前变得又冷又刮风。"
      },
      {
        "en": "I wear shorts, but she takes a warm wool sweater.",
        "zh": "我穿着短裤，她却带了一件暖和的羊毛衫。"
      },
      {
        "en": "Our foreign teacher sings a short, happy song for us.",
        "zh": "我们的外教老师为我们唱了一首短短的、欢快的歌。"
      },
      {
        "en": "Her clear pronunciation makes the new chant feel easy.",
        "zh": "她清晰的发音让这首新歌谣变得容易。"
      },
      {
        "en": "In mathematics, I copy each long step into my notebook.",
        "zh": "数学课上，我把每一个长长的步骤抄进笔记本。"
      },
      {
        "en": "Our science lab shows one strange, useful invention today.",
        "zh": "我们的科学实验室今天展示了一项奇怪又有用的发明。"
      }
    ],
    [
      {
        "en": "After violin practice, he runs to the big basketball game.",
        "zh": "小提琴练习结束后，他跑向盛大的篮球比赛。"
      },
      {
        "en": "Our class website shows old photos of my hometown.",
        "zh": "我们班的网站上有我家乡的老照片。"
      },
      {
        "en": "I read the long instruction twice before I realise the mistake.",
        "zh": "我把长长的说明读了两遍，才意识到那个错误。"
      },
      {
        "en": "The teacher will punish one small, careless spelling mistake.",
        "zh": "老师会为一个小小的粗心拼写错误而惩罚人。"
      },
      {
        "en": "A snowy afternoon makes my thin old raincoat useless.",
        "zh": "一个下雪的下午让我那件薄旧的雨衣毫无用处。"
      },
      {
        "en": "At the supermarket, we buy a big sweet apple pie.",
        "zh": "在超市里，我们买了一个大大的甜苹果派。"
      }
    ],
    [
      {
        "en": "A long sausage and some ham wait in the fridge.",
        "zh": "一根长长的香肠和一些火腿在冰箱里等着。"
      },
      {
        "en": "Cold lemonade and a red candy make us both smile.",
        "zh": "冰柠檬水和一颗红糖果让我们俩都笑了。"
      },
      {
        "en": "I do the housework, then rest on the soft sofa.",
        "zh": "我做完了家务，然后躺在柔软的沙发上休息。"
      },
      {
        "en": "By candle light, she pulls a thin thread through cloth.",
        "zh": "借着烛光，她把一根细线穿过布料。"
      },
      {
        "en": "The lazy cat turns away from the sour, warm milk.",
        "zh": "那只懒猫转身离开变酸的温牛奶。"
      },
      {
        "en": "The round moon begins to shine above our small house.",
        "zh": "圆圆的月亮开始在我们的小房子上方发光。"
      }
    ],
    [
      {
        "en": "At night, a bad toothache sends me to the dentist.",
        "zh": "夜里，一阵剧烈的牙痛把我送去看牙医。"
      },
      {
        "en": "An x-ray shows my tongue and one very bad tooth.",
        "zh": "一张 X 光片照出了我的舌头和一颗很坏的牙。"
      },
      {
        "en": "I feel well again, but I pity the sad tooth.",
        "zh": "我又感觉好了，但我还是同情那颗可怜的牙。"
      },
      {
        "en": "On the way, a sheep and a fat pig watch us.",
        "zh": "路上，一只羊和一头胖猪看着我们。"
      },
      {
        "en": "A toy lion on the shelf scares the brown rat away.",
        "zh": "架子上的一只玩具狮子把那只小棕鼠吓跑了。"
      },
      {
        "en": "My sister falls asleep before I fetch the warm blanket.",
        "zh": "我还没拿来暖和的毯子，妹妹就睡着了。"
      }
    ],
    [
      {
        "en": "The handsome doctor smiles at my ugly, red face.",
        "zh": "英俊的医生对着我难看的红脸笑了。"
      },
      {
        "en": "My elder sister says the doctor's granddaughter is very kind.",
        "zh": "我姐姐说医生的孙女非常善良。"
      },
      {
        "en": "The wind drops to zero, so the red kite falls.",
        "zh": "风停到零，所以那只红风筝落了下来。"
      },
      {
        "en": "It has been a long day, but my new shoes fit.",
        "zh": "这一天很长，但我新买的鞋子很合脚。"
      },
      {
        "en": "My shy sister still holds her broken red kite.",
        "zh": "我害羞的妹妹还抱着她那只坏掉的红风筝。"
      }
    ]
  ],
